// Fonksiyon tanimlama ve cagirma testleri

// Basit fonksiyon
fonk selamla(isim) {
    yazdir "Merhaba, " + isim + "!";
}

selamla("Kanka");
selamla("Dunya");

// Deger donduren fonksiyon
fonk topla(a, b) {
    dondur a + b;
}

degisken sonuc = topla(3, 7);
yazdir sonuc;

// Faktoriyel (rekursif)
fonk faktoriyel(n) {
    eger (n <= 1) {
        dondur 1;
    }
    dondur n * faktoriyel(n - 1);
}

yazdir faktoriyel(5);
yazdir faktoriyel(10);

// Fibonacci
fonk fibonacci(n) {
    eger (n <= 0) dondur 0;
    eger (n == 1) dondur 1;
    dondur fibonacci(n - 1) + fibonacci(n - 2);
}

icin (degisken i = 0; i < 8; i = i + 1) {
    yazdir fibonacci(i);
}

// Fonksiyon icinde degisken kapsami
fonk kapsam_testi() {
    degisken yerel = "yerel degisken";
    yazdir yerel;
}

kapsam_testi();

// Capanma (closure)
fonk sayac_olustur() {
    degisken adet = 0;
    fonk artir() {
        adet = adet + 1;
        dondur adet;
    }
    dondur artir;
}

degisken sayac = sayac_olustur();
yazdir sayac();
yazdir sayac();
yazdir sayac();
